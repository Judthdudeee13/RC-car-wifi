# ==============================================================================
# OS & IDE Junk (Keep your repo clean)
# ==============================================================================
.DS_Store
._.DS_Store
.Thumbs.db
.vscode/
.idea/
*.swp

# ==============================================================================
# Firmware & Microcontroller (Arduino, ESP32, STM32)
# ==============================================================================
# Build directories and binaries
build/
bin/
out/
*.hex
*.bin
*.elf
*.eep

# Libraries downloaded by package managers
.pio/
.pioenvs/
libdeps/
.clang_complete
.gcc-flags.json

# ==============================================================================
# Hardware / PCB Layout (KiCad, Altium, Eagle)
# ==============================================================================
# KiCad backup and auto-save files
*-backups/
*.kicad_prl
*.bak
*.lck
# Eagle / Altium lock and backup files
*.s#?
*.b#?
*.cop
*.ldk

# ==============================================================================
# CAD / 3D Printing (Fusion 360, SolidWorks, Blender)
# ==============================================================================
# Ignore heavy mesh/interchange files if you only want to track source files
# (Optional: uncomment if you don't want massive STLs cluttering history)
# *.stl
# *.step
# *.stp
*.tmp
*.log

# ==============================================================================
# Python / Web / Mobile App Controller (If building a custom remote)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.env
node_modules/
